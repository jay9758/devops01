# Copy this file to `.env` and adjust the values for your machine.
#   cp .env.example .env
# Never commit `.env` - it is listed in .gitignore.

# development | production | test
NODE_ENV=development

# 0.0.0.0 lets the app accept connections from outside a container.
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection string used by both the app and the Prisma CLI.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Azure Database for PostgreSQL append: ?sslmode=require
DATABASE_URL="postgresql://taskapp:task_password@localhost:5432/taskdb"

# Comma-separated list of browser origins allowed to call the API.
# Leave empty to keep CORS disabled (server-to-server and curl still work).
# Example: CORS_ORIGINS=http://localhost:5173,https://my-frontend.example.com
CORS_ORIGINS=
